<Window x:Class="client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/assets/logo.ico"
        Title="G.E.R.A.R.D" Height="680" Width="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="4" CornerRadius="8" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Border Background="#333333" CornerRadius="4" Margin="0,0,10,0" Padding="4" Width="24" Height="24">
                    <Image Source="pack://application:,,,/assets/logo.ico" 
                        RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>                
                <TextBlock Text="G.E.R.A.R.D" Foreground="#A0A0A0" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource FluentButton}" Width="40" FontSize="10" Click="Minimize_Click"/>
                <Button Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource FluentButton}" Width="40" FontSize="10" Click="Maximize_Click"/>
                <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource FluentButton}" Width="40" FontSize="10" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <ContentControl x:Name="MainContent" Grid.Row="1"/>
    </Grid>
</Window>