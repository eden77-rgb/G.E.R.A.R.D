<UserControl x:Class="client.views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent" Margin="40,20,40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
            <TextBlock Text="G.E.R.A.R.D" Foreground="#FFFFFF" FontSize="36" FontWeight="Light" HorizontalAlignment="Center"/>
            <TextBlock Text="Assistant IA multi-fonctions" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Actions principales" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="10,0,0,15"/>
            <ItemsControl x:Name="MainActionsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10" Cursor="Hand" Background="Transparent" MouseLeftButtonDown="Action_Click">
                            <Border Width="50" Height="50" Background="{Binding Color}" CornerRadius="12" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="#FFFFFF" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" Foreground="#E0E0E0" FontSize="11" HorizontalAlignment="Center" FontWeight="Medium"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Autres actions" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="10,25,0,15"/>
            <ItemsControl x:Name="OtherActionsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5,10" Cursor="Hand" Background="Transparent" MouseLeftButtonDown="Action_Click">
                            <Border Width="40" Height="40" Background="{Binding Color}" CornerRadius="8" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="#FFFFFF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" Foreground="#E0E0E0" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" Foreground="#68A0FA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Prompt personnalisé" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CustomPromptInput" Height="36" Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,8" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" KeyDown="CustomPrompt_KeyDown">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <Button Grid.Column="1" Content="Démarrer" Background="#333333" Foreground="#FFFFFF" BorderThickness="0" Margin="10,0,0,0" Padding="20,0" Click="Start_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>